{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "hseos",
  "version": "2.0.0",
  "description": "HSEOS — Hideaki Software Engineering Operating System. Spec-driven, AI-assisted institutional engineering framework.",
  "keywords": [
    "engineering",
    "ai",
    "agents",
    "governance",
    "framework",
    "hseos",
    "hideaki"
  ],
  "homepage": "https://github.com/marciohideaki/hseos#readme",
  "bugs": {
    "url": "https://github.com/marciohideaki/hseos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marciohideaki/hseos.git"
  },
  "license": "MIT",
  "author": "Marcio Hideaki",
  "type": "commonjs",
  "main": "tools/cli/hseos-cli.js",
  "bin": {
    "hseos": "tools/hseos-npx-wrapper.js"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "branch-protection:apply": "node scripts/governance/apply-branch-protection.js",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,yaml}\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,json,yaml}\"",
    "format:fix:staged": "prettier --write",
    "hseos:install": "node tools/cli/hseos-cli.js install",
    "hseos:uninstall": "node tools/cli/hseos-cli.js uninstall",
    "install:hseos": "node tools/cli/hseos-cli.js install",
    "lint": "eslint . --ext .js,.cjs,.mjs,.yaml --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs,.yaml --fix",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || exit 0",
    "test": "npm run test:schemas && npm run test:install && npm run test:detector && npm run test:state && npm run test:governance && npm run test:hooks && npm run test:ado-hooks && npm run test:state-emit-hook && npm run test:compiler-hooks && npm run test:capabilities && npm run test:smoke-install && npm run test:verify && npm run test:sandbox && npm run test:plugins && npm run test:adapter-sdk && npm run test:mcp-governance && npm run test:mcp-swarm && npm run test:mcp-project-state && npm run test:mcp-stdio && npm run test:mcp-axon-bridge && npm run test:mcp-contract && npm run test:mcp-2026 && npm run test:entrypoints && npm run test:compatibility && npm run test:agentic-foundation && npm run test:agentic-contracts && npm run test:agentic-session-store && npm run test:model-providers && npm run test:agent-context && npm run test:tool-runtime && npm run test:agent-runtime && npm run test:agent-capability-cli && npm run test:agentic-completion && npm run test:agentic-activation && npm run test:agent-provider-binding && npm run test:agent-compaction && npm run test:agent-orchestration && npm run test:runtime-providers && npm run validate:schemas && npm run lint",
    "test:adapter-sdk": "node test/test-adapter-sdk.js",
    "test:ado-hooks": "bash test/ado-ops/branch-guard.test.sh && bash test/ado-ops/feature-flag-disabled.test.sh && bash test/ado-ops/pr-link.test.sh && bash test/ado-ops/preflight-gate.test.sh && bash test/ado-ops/tag-close.test.sh",
    "test:agent-capability-cli": "node --test test/test-agent-capability-cli.js",
    "test:agent-compaction": "node --test test/test-agent-compaction.js",
    "test:agent-context": "node --test test/test-agent-context.js",
    "test:agent-orchestration": "node --test test/test-agent-orchestration.js",
    "test:agent-provider-binding": "node --test test/test-agent-provider-binding.js",
    "test:agent-runtime": "node --test test/test-agent-runtime.js",
    "test:agentic-activation": "node --test test/test-agentic-activation-rehearsal.js",
    "test:agentic-completion": "node --test test/test-agentic-completion-audit.js",
    "test:agentic-contracts": "node --test test/test-agent-runtime-contracts.js",
    "test:agentic-foundation": "node --test test/test-agentic-framework-foundation.js",
    "test:agentic-session-store": "node --test test/test-agent-session-store.js",
    "test:capabilities": "node test/test-capability-catalog.js",
    "test:compatibility": "node --test test/test-compatibility-audit.js test/test-compatibility-observation.js",
    "test:compiler-hooks": "node test/test-agent-core-compiler-hooks.js",
    "test:detector": "node test/test-detector-legacy-v4.js",
    "test:entrypoints": "node --test test/test-governed-entrypoints.js test/test-native-entrypoint-wiring.js",
    "test:governance": "node test/test-commit-msg.js && node test/test-governance-scripts.js && node test/test-solo-maintainer-governance.js && node test/test-pr-closeout.js",
    "test:hooks": "node test/test-hook-handlers.js && node test/test-blocking-hooks.js",
    "test:install": "node test/test-installation-components.js && node test/test-file-sync.js",
    "test:mcp-2026": "node --test test/test-mcp-2026-adapter.js",
    "test:mcp-axon-bridge": "node test/test-mcp-axon-bridge.js",
    "test:mcp-contract": "node test/test-mcp-contract.js",
    "test:mcp-governance": "node test/test-mcp-hseos-governance.js",
    "test:mcp-project-state": "node test/test-mcp-agent-state.js",
    "test:mcp-stdio": "node test/test-mcp-stdio.js",
    "test:mcp-swarm": "node test/test-mcp-hseos-swarm.js",
    "test:model-providers": "node --test test/test-model-providers.js",
    "test:plugins": "node test/test-plugin-marketplace.js",
    "test:runtime-providers": "node --test test/test-runtime-providers.js test/test-hosted-runtime-adapters.js",
    "test:sandbox": "node test/test-sandbox-cli.js",
    "test:schemas": "node test/test-agent-schema.js",
    "test:smoke-install": "node test/smoke-install-emit.js",
    "test:state": "node test/test-agent-state-dal.js && node --test test/test-operational-state-db.js test/test-execution-event-ledger.js test/test-execution-projections.js test/test-governed-execution-runtime.js && node test/test-state-cli.js && node test/test-state-render-lib.js && node test/test-state-ui.js && node test/test-kanban-cli.js && node test/test-state-purge.js && node test/test-kanban-central.js && node test/test-state-session.js",
    "test:state-emit-hook": "node test/test-state-emit-hook.js",
    "test:tool-runtime": "node --test test/test-tool-runtime.js",
    "test:verify": "node test/test-agent-core-verify-audit-doctor.js",
    "validate:schemas": "node tools/validate-agent-schema.js"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "npm run lint:fix",
      "npm run format:fix:staged"
    ],
    "*.yaml": [
      "eslint --fix",
      "npm run format:fix:staged"
    ],
    "*.json": [
      "npm run format:fix:staged"
    ]
  },
  "dependencies": {
    "@clack/core": "^1.0.0",
    "@clack/prompts": "^1.0.0",
    "@kayvan/markdown-tree-parser": "^1.6.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.9.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "csv-parse": "^6.1.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.6.3",
    "xml2js": "^0.6.2",
    "yaml": "^2.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "c8": "^10.1.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-yml": "^1.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "yaml-eslint-parser": "^1.2.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
