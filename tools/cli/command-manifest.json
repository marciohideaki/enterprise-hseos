          "Allow a verified private snapshot when the source has active SQLite WAL sidecars"
        ],
        [
          "--json",
          "Output machine-readable JSON"
        ],
        [
          "--require-rehearsal-ready",
          "Exit non-zero unless migration, rollback, profile and source immutability pass"
