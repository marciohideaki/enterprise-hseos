{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hideakiservicos.com/hseos/capability-reference-corpus/1.0.0",
  "title": "Platform Capability Reference Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "authority", "capability_baseline", "semantic_discovery", "sources"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "corpus_id": { "$ref": "#/$defs/id" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "canonical_mutation", "creates_adoption"],
      "properties": {
        "role": { "const": "discovery-only" },
        "canonical_mutation": { "const": false },
        "creates_adoption": { "const": false }
      }
    },
    "capability_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "source_hint", "as_of", "count", "capability_ids"],
      "properties": {
        "authority": { "const": "migration-view" },
        "source_hint": { "type": "string", "minLength": 1 },
        "as_of": { "type": "string", "format": "date" },
        "count": { "type": "integer", "minimum": 1 },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "semantic_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "engine", "query", "executed_on"],
      "properties": {
        "authority": { "const": "advisory" },
        "engine": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "executed_on": { "type": "string", "format": "date" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "kind",
        "evidence_role",
        "revision",
        "source_uri",
        "stacks",
        "architecture_signals",
        "evidence_paths",
        "candidate_capabilities"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["product-sentinel", "canonical-core"] },
        "evidence_role": { "enum": ["candidate-source", "contract-or-projection-source"] },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "source_uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "stacks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "architecture_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "candidate_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "product-sentinel" } } },
          "then": { "properties": { "evidence_role": { "const": "candidate-source" } } },
          "else": { "properties": { "evidence_role": { "const": "contract-or-projection-source" } } }
        }
      ]
    }
  }
}
